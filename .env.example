# Palo Alto firewall management IP or hostname
PANOS_HOST=10.250.X.X

# PAN-OS XML API key (generate via: curl -k "https://<host>/api/?type=keygen&user=<user>&password=<pass>")
# Keys are tied to admin credentials — regenerate after any password change.
# Use a dedicated least-privilege service account scoped to: import, config read/set, commit.
PANOS_API_KEY=

# TLS verification for the firewall management interface.
# false   — skip verification (default; acceptable for self-signed mgmt certs)
# true    — verify against system CA bundle
# /path   — verify against a specific CA bundle (e.g. your Step-CA root cert)
PANOS_VERIFY_SSL=false

# Whether to automatically commit after remapping profiles.
# true  — (default) validate and commit automatically after all changes are staged
# false — import cert and remap profiles, then stop. Changes remain in candidate
#         config for manual review (Monitor > Commit > Preview) before committing.
#         Per-run override: pass --no-commit flag to force staged mode regardless.
PANOS_AUTO_COMMIT=true
